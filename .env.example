# Copy this file to .env for local use. Replace every value before production deployment.
POSTGRES_DB=gbh
POSTGRES_USER=gbh_app
POSTGRES_PASSWORD=local-postgres-admin-change-this
DB_USER=gbh_runtime
DB_PASSWORD=local-postgres-app-change-this

# Production-safe defaults; compose.dev.yaml overrides these for local testing.
APP_ENV=production
APP_PORT=8080
ALLOWED_ORIGINS=https://gbh.example.edu
SESSION_COOKIE_NAME=gbh_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
